#!/bin/python3
"""Manage PipeWire audio devices: list, toggle and set default outputs/inputs.

Devices are identified by their stable PipeWire `device.name` (e.g.
alsa_card.usb-..., bluez_card.XX_XX...). Legacy config entries keyed by
`alsa.card_name` still match. Configured profiles that no longer exist on a
device fall back to the best available profile of the same type.
"""

from argparse import ArgumentParser
from os import environ, system
from pathlib import Path
from subprocess import run, PIPE
from sys import exit, stderr
from time import sleep
from typing import Any
import json

DEBUG = False

OUTPUT = "output"
INPUT = "input"
IO = "io"
CARD_TYPES = (OUTPUT, INPUT, IO)

NODE_WAIT_RETRIES = 15
NODE_WAIT_INTERVAL = 0.2


class Colors:
    OKBLUE = '\033[94m'
    OKCYAN = '\033[96m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'
    HEADER = '\033[95m'


def debug_log(message: str) -> None:
    if DEBUG:
        print(f"{Colors.WARNING}[DEBUG]{Colors.ENDC} {message}", file=stderr)


def fail(message: str) -> None:
    print(f"{Colors.FAIL}{message}{Colors.ENDC}", file=stderr)
    run(["notify-send", "-u", "critical", "Sound Manager", message])
    exit(1)


# --- PipeWire state ---------------------------------------------------------

def props(obj: dict) -> dict:
    return obj.get("info", {}).get("props", {})


def params(obj: dict) -> dict:
    return obj.get("info", {}).get("params", {})


def device_name(device: dict) -> str:
    return props(device).get("device.name", "")


def active_profile(device: dict) -> str | None:
    profiles = params(device).get("Profile", [])
    return profiles[0].get("name") if profiles else None


def display_name(device: dict) -> str:
    p = props(device)
    return (p.get("alsa.card_name") or p.get("device.alias")
            or p.get("device.product.name") or p.get("device.description")
            or device_name(device))


class PwState:
    """A single pw-dump snapshot with lookups for devices, nodes and defaults."""

    def __init__(self):
        objects = json.loads(run(["pw-dump"], stdout=PIPE).stdout.decode())
        self.devices = [
            o for o in objects
            if o.get("type") == "PipeWire:Interface:Device"
            and props(o).get("media.class") == "Audio/Device"
        ]
        self.nodes = [o for o in objects if o.get("type") == "PipeWire:Interface:Node"]
        self.metadata = [o for o in objects if o.get("type") == "PipeWire:Interface:Metadata"]

    def default_node_name(self, key: str) -> str | None:
        for meta in self.metadata:
            for item in meta.get("metadata", []):
                if item.get("key") == key:
                    value = item.get("value")
                    return value.get("name") if isinstance(value, dict) else None
        return None

    def node_by_name(self, name: str) -> dict | None:
        for node in self.nodes:
            if props(node).get("node.name") == name:
                return node
        return None

    def device_by_id(self, device_id: Any) -> dict | None:
        for device in self.devices:
            if device.get("id") == device_id:
                return device
        return None

    def device_nodes(self, device: dict, media_class: str) -> list[dict]:
        device_id = device.get("id")
        return [
            n for n in self.nodes
            if props(n).get("device.id") == device_id
            and props(n).get("media.class") == media_class
        ]

    def default_device(self, kind: str) -> tuple[dict | None, str | None]:
        """kind: 'sink' or 'source'. Returns (device, its active profile)."""
        node_name = self.default_node_name(f"default.audio.{kind}")
        if not node_name:
            debug_log(f"no default audio {kind} in metadata")
            return None, None
        node = self.node_by_name(node_name)
        if node is None:
            debug_log(f"default {kind} node '{node_name}' not found")
            return None, None
        device = self.device_by_id(props(node).get("device.id"))
        if device is None:
            debug_log(f"default {kind} node '{node_name}' has no device")
            return None, None
        return device, active_profile(device)


# --- Profiles ---------------------------------------------------------------

def profile_matches_type(profile: dict, card_type: str, exclusive: bool) -> bool:
    classes = profile.get("classes", [])
    has_sink = any("Audio/Sink" in str(c) for c in classes)
    has_source = any("Audio/Source" in str(c) for c in classes)

    if card_type == OUTPUT:
        return has_sink and (not exclusive or not has_source)
    if card_type == INPUT:
        return has_source and (not exclusive or not has_sink)
    return has_sink and has_source


def profiles_for_type(device: dict, card_type: str, exclusive: bool) -> list[dict]:
    return [
        p for p in params(device).get("EnumProfile", [])
        if p.get("available", "no") != "no"
        and profile_matches_type(p, card_type, exclusive)
    ]


def best_profile(profiles: list[dict]) -> dict | None:
    return max(profiles, key=lambda p: p.get("priority", 0), default=None)


# --- Configuration ----------------------------------------------------------

def get_config_path() -> Path:
    config_dir = Path(environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_dir / "sound_manager" / "config.json"


def load_config() -> dict:
    path = get_config_path()
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        debug_log("could not parse config file, ignoring it")
        return {}


def entry_key(entry: dict) -> str:
    # "device" is the stable device.name; "card_name" is the legacy key
    return entry.get("device") or entry.get("card_name", "")


def find_device(state: PwState, key: str) -> dict | None:
    if not key:
        return None
    for device in state.devices:
        p = props(device)
        if key in (p.get("device.name"), p.get("alsa.card_name")):
            return device
    return None


# --- Device entries ---------------------------------------------------------

def resolve_entry(state: PwState, entry: dict, card_type: str) -> dict | None:
    """Match a config entry against a live device, validating its profile."""
    device = find_device(state, entry_key(entry))
    if device is None:
        return None

    profiles = profiles_for_type(device, card_type, exclusive=False)
    if not profiles:
        return None

    profile = entry.get("profile")
    if profile not in [p["name"] for p in profiles]:
        fallback = best_profile(profiles)
        debug_log(f"profile '{profile}' no longer exists on {entry_key(entry)}, "
                  f"using '{fallback['name']}'")
        profile = fallback["name"]

    alias = entry.get("alias")
    return {
        "device": device_name(device),
        "profile": profile,
        "alias": alias,
        "display_name": alias or display_name(device),
    }


def get_entries(state: PwState, config: dict, card_type: str) -> list[dict]:
    """Configured entries in priority order, then defaults for other devices."""
    kind = "source" if card_type == INPUT else "sink"
    active_device, active_prof = state.default_device(kind)
    active_key = device_name(active_device) if active_device else None

    entries = []
    seen_devices = set()
    seen_pairs = set()
    for conf in config.get(card_type, []):
        entry = resolve_entry(state, conf, card_type)
        if entry is None:
            continue
        seen_devices.add(entry["device"])
        pair = (entry["device"], entry["profile"])
        if pair in seen_pairs:
            continue
        seen_pairs.add(pair)
        entries.append(entry)

    for device in state.devices:
        name = device_name(device)
        if not name or name in seen_devices:
            continue
        profile = best_profile(profiles_for_type(device, card_type, exclusive=True))
        if profile is None:
            continue
        entries.append({
            "device": name,
            "profile": profile["name"],
            "alias": None,
            "display_name": display_name(device),
        })

    for entry in entries:
        entry["active"] = (entry["device"] == active_key
                           and entry["profile"] == active_prof)
    return entries


# --- Actions ----------------------------------------------------------------

def wait_for_node(device_key: str, media_class: str) -> dict | None:
    """Wait for a node to appear on the device; profiles activate asynchronously."""
    for _ in range(NODE_WAIT_RETRIES):
        state = PwState()
        device = find_device(state, device_key)
        if device is not None:
            nodes = state.device_nodes(device, media_class)
            if nodes:
                return max(nodes, key=lambda n: props(n).get("priority.session", 0))
        sleep(NODE_WAIT_INTERVAL)
    return None


def disable_other_devices(state: PwState, keep: set[str], media_classes: tuple[str, ...]) -> None:
    """Profile other cards off — active cards take routing precedence over the default."""
    for device in state.devices:
        name = device_name(device)
        if name in keep:
            continue
        if active_profile(device) in (None, "off"):
            continue
        if not any(state.device_nodes(device, mc) for mc in media_classes):
            continue
        debug_log(f"turning off {name}")
        if run(["pactl", "set-card-profile", name, "off"]).returncode != 0:
            debug_log(f"failed to turn off {name}")


def move_streams(kind: str) -> None:
    """Move live streams to the new default; cards left enabled would keep them otherwise."""
    if kind == "sink":
        list_type, move_cmd, target = "sink-inputs", "move-sink-input", "@DEFAULT_SINK@"
    else:
        list_type, move_cmd, target = "source-outputs", "move-source-output", "@DEFAULT_SOURCE@"

    streams = run(["pactl", "list", "short", list_type], stdout=PIPE).stdout.decode()
    for line in streams.splitlines():
        stream_id = line.split("\t")[0]
        if stream_id:
            run(["pactl", move_cmd, stream_id, target])


def set_default(state: PwState, card_type: str, device_key: str, profile: str,
                alias: str | None = None) -> None:
    device = find_device(state, device_key)
    if device is None:
        fail(f"Device not found: {device_key}")
    name = device_name(device)
    label = alias or display_name(device)

    if active_profile(device) != profile:
        debug_log(f"setting profile '{profile}' on {name}")
        if run(["pactl", "set-card-profile", name, profile]).returncode != 0:
            fail(f"Could not set profile '{profile}' on {label}")

    if card_type in (OUTPUT, IO):
        node = wait_for_node(name, "Audio/Sink")
        if node is None:
            fail(f"No output appeared on {label} for profile '{profile}'")
        node_name = props(node).get("node.name", "")
        debug_log(f"setting default sink to {node_name}")
        if run(["pactl", "set-default-sink", node_name]).returncode != 0:
            fail(f"Could not set default output to {label}")
        move_streams("sink")

    if card_type in (INPUT, IO):
        node = wait_for_node(name, "Audio/Source")
        if node is None:
            fail(f"No input appeared on {label} for profile '{profile}'")
        node_name = props(node).get("node.name", "")
        debug_log(f"setting default source to {node_name}")
        if run(["pactl", "set-default-source", node_name]).returncode != 0:
            fail(f"Could not set default input to {label}")
        move_streams("source")

    if card_type == INPUT:
        # keep the current output alive; only silence other source-bearing cards
        sink_device, _ = state.default_device("sink")
        keep = {name, device_name(sink_device)} if sink_device else {name}
        disable_other_devices(state, keep, ("Audio/Source",))
    elif card_type == OUTPUT:
        # likewise keep the card hosting the current input alive
        source_device, _ = state.default_device("source")
        keep = {name, device_name(source_device)} if source_device else {name}
        disable_other_devices(state, keep, ("Audio/Sink",))
    else:
        disable_other_devices(state, {name}, ("Audio/Sink", "Audio/Source"))

    header = {OUTPUT: "Switched Output", INPUT: "Switched Input", IO: "Switched IO"}
    run(["notify-send", header[card_type], label])


def toggle_output(state: PwState, config: dict) -> None:
    entries = get_entries(state, config, OUTPUT)
    if not entries:
        fail("No output devices available")

    current = next((i for i, e in enumerate(entries) if e["active"]), -1)
    entry = entries[(current + 1) % len(entries)]
    debug_log(f"toggling output to {entry['device']} / {entry['profile']}")
    set_default(state, OUTPUT, entry["device"], entry["profile"], entry["alias"])


def list_entries(state: PwState, config: dict) -> None:
    print(json.dumps({t: get_entries(state, config, t) for t in CARD_TYPES}))


# --- Interactive configuration ----------------------------------------------

def save_card_config(config: dict) -> None:
    config_path = get_config_path()
    config_path.parent.mkdir(parents=True, exist_ok=True)

    system('clear')
    print(f"{Colors.BOLD}{Colors.HEADER}Saving priority order{Colors.ENDC}")
    for device_type, entries in config.items():
        if not entries:
            continue
        print(f"\n\t{Colors.OKCYAN}{device_type.upper()}{Colors.ENDC}")
        for i, entry in enumerate(entries, 1):
            alias_str = (f" (alias: {Colors.WARNING}{entry.get('alias')}{Colors.ENDC})"
                         if entry.get('alias') else "")
            print(f"\t{Colors.OKGREEN}{i}.{Colors.ENDC} {entry_key(entry)} - {entry['profile']}{alias_str}")

    with open(config_path, "w") as f:
        json.dump(config, f, indent=2)

    print(f"\n{Colors.OKGREEN}Configuration saved to {config_path}{Colors.ENDC}")


def configure_cards(state: PwState) -> None:
    config = load_config()

    for card_type in CARD_TYPES:
        system('clear')
        print(f"{Colors.BOLD}{Colors.HEADER}Configuring sound profile preference list{Colors.ENDC}")
        print(f"{Colors.WARNING}Run this with all sound devices connected so you can configure all your options{Colors.ENDC}\n")

        current = config.get(card_type, [])

        # (device.name, profile name, label) for every live profile of this type
        candidates = []
        for device in state.devices:
            name = device_name(device)
            for p in profiles_for_type(device, card_type, exclusive=False):
                candidates.append((name, p["name"], f"{display_name(device)} - {p['name']}"))

        # keep configured entries whose device is currently disconnected selectable
        connected = {(key, prof) for key, prof, _ in candidates}
        for entry in current:
            key, prof = entry_key(entry), entry.get("profile")
            if find_device(state, key) is None and (key, prof) not in connected:
                candidates.append((key, prof, f"{key} - {prof} {Colors.WARNING}(disconnected){Colors.ENDC}"))

        print(f"{Colors.BOLD}{Colors.OKCYAN}Configuring {card_type.upper()} profiles{Colors.ENDC}")

        print(f"\n{Colors.OKBLUE}Currently configured profiles:{Colors.ENDC}")
        if not current:
            print("\tNone")
        for i, entry in enumerate(current, 1):
            alias_str = (f" (alias: {Colors.WARNING}{entry['alias']}{Colors.ENDC})"
                         if entry.get("alias") else "")
            print(f"\t{Colors.OKGREEN}{i}.{Colors.ENDC} {entry_key(entry)} - {entry['profile']}{alias_str}")

        print(f"\n{Colors.OKBLUE}Available profiles:{Colors.ENDC}")
        if not candidates:
            print("\tNone")
        for i, (_, _, label) in enumerate(candidates, 1):
            print(f"\t{Colors.OKGREEN}{i}.{Colors.ENDC} {label}")

        while True:
            try:
                print(f"\n{Colors.BOLD}{Colors.WARNING}Enter new priority order for {card_type}{Colors.ENDC} (e.g., '3,1,2')")
                print(f"{Colors.WARNING}Append aliases with ':' (e.g., '1:main,2:headphones'). Leave empty to keep current config.{Colors.ENDC}")
                order_input = input(f"{Colors.BOLD}New {card_type} priority: {Colors.ENDC}")
                if not order_input.strip():
                    break

                new_entries = []
                for o in order_input.split(","):
                    alias = None
                    number_str = o
                    if ":" in o:
                        number_str, alias = o.split(":", 1)

                    number = int(number_str) - 1
                    if not (0 <= number < len(candidates)):
                        raise ValueError("Invalid profile number.")

                    key, prof, _ = candidates[number]
                    new_entries.append({
                        "device": key,
                        "profile": prof,
                        "alias": alias,
                    })

                config[card_type] = new_entries
                break

            except ValueError as e:
                print(f"{Colors.FAIL}Invalid input: {e}. Please try again.{Colors.ENDC}")
            except KeyboardInterrupt:
                print(f"\n{Colors.WARNING}Configuration cancelled.{Colors.ENDC}")
                return

    if config:
        save_card_config(config)


# --- Main -------------------------------------------------------------------

if __name__ == "__main__":
    ap = ArgumentParser(
        "sound_manager",
        description="Manage PipeWire sound devices and profiles",
    )
    ap.add_argument("-l", help="List available devices as JSON", action="store_true")
    ap.add_argument("-t", help="Toggle between output devices", action="store_true")
    ap.add_argument(
        "-s", nargs=3, metavar=('device', 'profile', 'type'),
        help="Set default device (type: output | input | io)",
    )
    ap.add_argument("-c", "--configure", help="Configure device priorities and aliases", action="store_true")
    ap.add_argument("--debug", help="Enable debug logs", action="store_true")
    args = ap.parse_args()

    DEBUG = args.debug
    state = PwState()
    config = load_config()

    if args.l:
        list_entries(state, config)
    elif args.t:
        toggle_output(state, config)
    elif args.s:
        device_key, profile, card_type = args.s
        card_type = card_type.lower()
        if card_type not in CARD_TYPES:
            fail(f"Invalid type '{card_type}' (expected output, input or io)")
        alias = next((e["alias"] for e in get_entries(state, config, card_type)
                      if e["device"] == device_key and e["profile"] == profile), None)
        set_default(state, card_type, device_key, profile, alias)
    elif args.configure:
        configure_cards(state)
    else:
        ap.print_help()

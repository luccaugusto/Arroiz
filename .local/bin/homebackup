#!/usr/bin/env bash

# Backup important directories to the directory specified.
# Run 'homebackup --help' for details.

default_directories_to_backup=("$HOME/Documents/" "$HOME/pics/" "$HOME/.ssh/")
media_directories_to_backup=("$HOME/Music/" "$HOME/Downloads/")
exclude_directories=("Media")

print_help()
{
	cat <<EOF
usage: ${0##*/} [options] <backup_dir>

Backs up important directories into <backup_dir>. By default a compressed
tar archive named backup-YYYY-MM-DD.tar.gz is created. Before backing up,
the total size of the directories is computed with du and the backup is
aborted if the filesystem of <backup_dir> does not have enough free space.

Default directories: ${default_directories_to_backup[*]}
Media directories (only with --media): ${media_directories_to_backup[*]}
Always excluded (at any depth): ${exclude_directories[*]}

options:
  -a, --archive        create an uncompressed tar archive
                       (backup-YYYY-MM-DD.tar) instead of a .tar.gz
  -u, --uncompressed   no archive at all: copy the files into a plain
                       directory (backup-YYYY-MM-DD/) with rsync -a
  -m, --media          also back up the media directories, in full
  -d, --dir DIR        back up DIR instead of the default directories;
                       can be repeated. --media still adds the media
                       directories on top
  -h, --help           show this help and exit

-a and -u are mutually exclusive.
EOF
}

die()
{
	echo "ERROR: $1" >&2
	echo "run '${0##*/} --help' for help" >&2
	exit 1
}

archive=""
uncompressed=""
include_media=""
custom_directories=()
backup_dir=""

while [ $# -gt 0 ]; do
	case "$1" in
		-a|--archive) archive=1 ;;
		-u|--uncompressed) uncompressed=1 ;;
		-m|--media) include_media=1 ;;
		-d|--dir)
			[ "$2" ] || die "$1 requires a directory argument"
			custom_directories+=("$2")
			shift
			;;
		-h|--help) print_help; exit 0 ;;
		-*) die "unknown option: $1" ;;
		*)
			[ "$backup_dir" ] && die "unexpected argument: $1"
			backup_dir="${1%/}"
			;;
	esac
	shift
done

[ "$archive" ] && [ "$uncompressed" ] && die "-a/--archive and -u/--uncompressed are mutually exclusive"
[ "$backup_dir" ] || die "no backup directory specified"
[ -d "$backup_dir" ] || die "backup directory '$backup_dir' does not exist"

if [ "${#custom_directories[@]}" -gt 0 ]; then
	directories_to_backup=("${custom_directories[@]}")
else
	directories_to_backup=("${default_directories_to_backup[@]}")
fi
[ "$include_media" ] && directories_to_backup+=("${media_directories_to_backup[@]}")

for directory in "${directories_to_backup[@]}"; do
	[ -d "$directory" ] || die "directory to back up '$directory' does not exist"
done

exclude_args=()
for directory in "${exclude_directories[@]}"; do
	exclude_args+=("--exclude=$directory")
done

# sizes in 1K blocks, same unit df reports free space in
total_file_size=0
for directory in "${directories_to_backup[@]}"; do
	backup_size="$(du -s "${exclude_args[@]}" "$directory" | awk '{print $1}')"
	total_file_size=$((total_file_size + backup_size))
done
human_readable_file_size="$(echo "$total_file_size" | awk '{ printf "%.2fGB\n", $1/1024/1024; }')"
space_available_in_backup_dir="$(df "$backup_dir" | awk 'END{print $4}')"

[ "$space_available_in_backup_dir" -gt "$total_file_size" ] || {
	echo "Not enough free space on disk, won't backup." >&2
	echo "Backup size: $human_readable_file_size" >&2
	echo "Free space: $(df -h "$backup_dir" | awk 'END{print $4}')" >&2
	exit 1
}

# EXECUTE BACKUP
backup_name="backup-$(date +%Y-%m-%d)"
if [ "$uncompressed" ]; then
	backup_path="$backup_dir/$backup_name"
	mkdir -p "$backup_path" || die "could not create '$backup_path'"
	# strip trailing slashes so rsync copies the directories themselves,
	# not just their contents
	rsync_sources=()
	for directory in "${directories_to_backup[@]}"; do
		rsync_sources+=("${directory%/}")
	done
	rsync -av "${exclude_args[@]}" "${rsync_sources[@]}" "$backup_path/" || die "rsync failed"
else
	if [ "$archive" ]; then
		backup_path="$backup_dir/$backup_name.tar"
		tar_flags="-cpPvf"
	else
		backup_path="$backup_dir/$backup_name.tar.gz"
		tar_flags="-cpzPvf"
	fi
	tar "${exclude_args[@]}" --full-time "$tar_flags" "$backup_path" "${directories_to_backup[@]}" || die "tar failed"
fi

human_readable_space_available_in_backup_dir="$(df -h "$backup_dir" | awk 'END{print $4}')"

# Telemetry
echo "[DONE] Backup created at $backup_path"
echo "	Excluded directories: ${exclude_directories[*]}"
echo "	Backup file size: $human_readable_file_size"
echo "	Free space remaining: $human_readable_space_available_in_backup_dir"

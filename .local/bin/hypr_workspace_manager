#!/usr/bin/env bash

# This script requires jq to be installed.
#
# Usage:
# workspace_manager <workspace_number>
# workspace_manager "move <workspace_number>"
# workspace_manager "other"
#
# This script switches to or moves a window to a workspace based on the focused monitor.
# It dynamically supports any number of monitors, assigning 10 workspaces per monitor.
# Monitor order matches monitor_manager.sh: laptop first (eDP-1), then external monitors.


# Get all monitors in order (sorted by ID to ensure consistent ordering)
all_monitors=$(hyprctl -j monitors | jq -r 'sort_by(.id) | .[].name')

# Get focused monitor info
focused_monitor=$(hyprctl -j monitors | jq -r '.[] | select(.focused)')
focused_monitor_name=$(echo "$focused_monitor" | jq -r '.name')

# Find the index of the focused monitor in the ordered list
monitor_index=0
for monitor in $all_monitors; do
	if [ "$monitor" = "$focused_monitor_name" ]; then
		break
	fi
	monitor_index=$((monitor_index + 1))
done

action="workspace"
workspace=$1

# Check if the first argument is "move"
if [ "$1" = "move" ]; then
    action="movetoworkspace"
    workspace=$2
elif [ "$1" = "other" ]; then
	# Move window to the corresponding workspace on the next monitor (cycling)
	action="movetoworkspace"
	current_workspace=$(echo "$focused_monitor" | jq -r '.activeWorkspace.id')

	num_monitors=$(echo "$all_monitors" | wc -l)
	next_monitor_index=$(( (monitor_index + 1) % num_monitors ))
	workspace_offset=$(( (current_workspace - 1) % 10 + 1 ))
	workspace=$(( next_monitor_index * 10 + workspace_offset ))
fi

# Calculate the actual workspace number based on monitor index
# Each monitor gets 10 workspaces: monitor 0 gets 1-10, monitor 1 gets 11-20, etc.
if [ "$1" != "other" ]; then
	workspace=$((monitor_index * 10 + workspace))
fi

# Dispatch the command to hyprctl
hyprctl dispatch "$action" "$workspace"
